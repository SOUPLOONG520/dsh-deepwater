{
  "name": "dsh-deepwater",
  "version": "1.0.3",
  "description": "Deep-water theme for the DeepSeek Harness: a glacier-blue surface layer and a deep-water ambience layer, in one switchable package.",
  "license": "MIT",
  "author": "SOUPLOONG520",
  "type": "module",
  "main": "entry.js",
  "exports": {
    ".": "./entry.js",
    "./client": "./client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "verify",
    "client.js",
    "cordis.patch.yml",
    "entry.js",
    "build-client.mjs",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "theme",
    "cordis-plugin"
  ],
  "dsh": {
    "client": {
      "platform": "web",
      "immediately": true
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
